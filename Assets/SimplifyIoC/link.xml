<?xml version="1.0" encoding="utf-8"?>
<!--
  SimplifyIoC 链接保留配置（IL2CPP / Managed Stripping）

  背景（见 .workbuddy/review/design-and-aot-2026-09-18.md §11）：
  2.5 之后框架内部已消除 MakeGenericType（命令池直接构造非泛型 Pool；
  ChildAttribute 用字段声明的闭泛型 / 静态容器收集 + Array.CreateInstance）。
  本文件的保留配置降级为双保险：
    - Pool<T> / Pool 等 public 泛型 API 仍可能被使用方以 typeof(Pool<>).MakeGenericType
      等方式使用，整体保留包程序集可兜底。
    - List`1 兜底保留（使用者代码可能对 BCL 泛型容器做运行期实例化）。

  使用者注意：
  - 你的 Command/Signal 等类型在自己的程序集里，若你的工程也开了裁剪，
    建议在你的 Assembly Definition 对应程序集上也加 preserve，或把
    Managed Stripping Level 固定在 Low 并在真机上回归一遍命令池路径。
  - ignoreIfMissing="1" 使本文件在包未被引用时不会报错。
-->
<linker>
  <assembly fullname="UMa.SimplifyIoC" preserve="all" ignoreIfMissing="1" />

  <!-- MakeGenericType 涉及的 BCL 泛型容器兜底（按需可自行增删） -->
  <assembly fullname="mscorlib" ignoreIfMissing="1">
    <type fullname="System.Collections.Generic.List`1" preserve="all" />
  </assembly>
  <assembly fullname="netstandard" ignoreIfMissing="1">
    <type fullname="System.Collections.Generic.List`1" preserve="all" />
  </assembly>
</linker>
